# MohToh Environment Configuration

# Current environment: LOCAL, STAGING, PRODUCTION, or auto
APP_ENV=LOCAL

# Override base URL (if set, this is used directly for APP_BASE_URL)
APP_BASE_URL=

# Environment-specific base URLs (used if APP_BASE_URL is empty and APP_ENV matches)
APP_BASE_URL_LOCAL=http://app.mohtoh.com.ng/Mostmerit/merit_drives
APP_BASE_URL_STAGING=https://staging.mohtoh.com.ng
APP_BASE_URL_PRODUCTION=https://app.mohtoh.com.ng

# Allowed hosts for Host header validation (comma-separated list)
# Leaving this empty allows all validly formatted hosts (useful for local development/auto-detect)
ALLOWED_HOSTS=app.mohtoh.com.ng,127.0.0.1,staging.mohtoh.com.ng,app.mohtoh.com.ng

# AES-256 key (exactly 64 hex characters = 32 bytes) used by includes/secrets.php
# to encrypt credentials at rest (SMTP passwords, integration API secrets, and
# MOHTOH NETWORK withdrawal bank account numbers). Generate your own with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# If left empty or invalid, the app silently falls back to a key derived from
# a FIXED, PUBLIC salt in includes/secrets.php — anyone who has read that file
# (it's in this repository) can derive that fallback key. Every environment
# that stores real credentials or real bank account numbers MUST set a real
# value here. See MOHTOH_SECURITY_CREDENTIAL_REMEDIATION.md before rotating
# an already-in-use key — rotating without re-encrypting existing data makes
# it permanently unreadable.
APP_ENCRYPTION_KEY=

# Database credentials (see includes/db.php). If left empty, the app falls
# back to the XAMPP local-development default (root / no password) so a
# fresh local checkout keeps working with zero setup. Any shared/production
# environment MUST set real values here — never rely on the local-dev
# fallback outside a developer's own machine.
DB_HOST=localhost
DB_NAME=merit_drives
DB_USER=root
DB_PASSWORD=
